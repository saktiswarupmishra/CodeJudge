# Database
DATABASE_URL="mysql://root:@localhost:3306/online_judge"

# JWT
JWT_SECRET="oj-super-secret-key-change-in-production-2024"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_HOST="127.0.0.1"
