# Server
PORT=3000
NODE_ENV="development"

# Docker Execution
DOCKER_TIMEOUT=10000
DOCKER_MEMORY_LIMIT=268435456
DOCKER_CPU_LIMIT=1

# Twilio SMS
TWILIO_ACCOUNT_SID="your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_number"
